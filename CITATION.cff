    family-names: Nagler
    email: benedikt.nagler@protonmail.com
license: MIT
repository-code: "https://github.com/benedikt-nagler/ClusterAlgebras.jl"
url: "https://benedikt-nagler.github.io/ClusterAlgebras.jl/stable"
keywords:
  - cluster algebras
  - quiver mutation
  - Fomin-Zelevinsky
  - maximal green sequences
  - friezes
  - root systems
  - Julia
